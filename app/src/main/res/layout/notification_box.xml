<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_notification_box"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 1. बायाँ भाग: 2-लाइन मोड और सब्जेक्ट स्टैक (नो ओवरलैप) -->
    <LinearLayout
        android:id="@+id/notif_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start|center_vertical"
        android:paddingEnd="8dp">

        <!-- लाइन 1: डायनामिक मोड (जैसे: ⚡ FOCUS TIMER या ⚡ POMODORO) -->
        <TextView
            android:id="@+id/notif_mode_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ FOCUS TIMER"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#EAB308"
            android:letterSpacing="0.04"
            android:singleLine="true" />

        <!-- लाइन 2: लाइव सब्जेक्ट का नाम -->
        <TextView
            android:id="@+id/notif_subject_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject • Coding"
            android:textSize="10sp"
            android:textColor="#94A3B8"
            android:layout_marginTop="2dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 2. बीच का भाग: बड़ा डिजिटल गोल्डन टाइमर -->
    <Chronometer
        android:id="@+id/notif_timer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="31sp"
        android:textStyle="bold"
        android:textColor="#F59E0B"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:singleLine="true" />

    <!-- 3. दायाँ भाग: बॉर्डरलेस एक्शन बटन्स -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Pause / Resume बटन -->
        <ImageView
            android:id="@+id/btn_notif_pause"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_notif_pause"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:padding="5dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Pause" />

        <!-- Stop बटन -->
        <ImageView
            android:id="@+id/btn_notif_stop"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_notif_stop"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:padding="5dp"
            android:contentDescription="Stop" />
    </LinearLayout>

</LinearLayout>
