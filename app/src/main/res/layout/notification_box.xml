<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#16161E"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 1. बायाँ भाग: लोगो (@drawable/ic_launcher) + मोड टैग -->
    <LinearLayout
        android:id="@+id/notif_logo_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/notif_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="fitCenter"
            android:contentDescription="Amon Logo" />

        <TextView
            android:id="@+id/notif_mode_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOCUS"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:textColor="#8B5CF6"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 2. बीच का भाग: टाइमर डिस्प्ले -->
    <Chronometer
        android:id="@+id/notif_timer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:singleLine="true" />

    <!-- 3. दायाँ भाग: एक्शन बटन्स (बिना Space टैग के) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- PAUSE / RESUME बटन (मार्जिन के ज़रिए 8dp दूरी दी गई) -->
        <TextView
            android:id="@+id/btn_notif_pause"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="56dp"
            android:gravity="center"
            android:text="PAUSE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#262634"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="8dp" />

        <!-- STOP बटन -->
        <TextView
            android:id="@+id/btn_notif_stop"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="50dp"
            android:gravity="center"
            android:text="STOP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#EF4444"
            android:background="#262634"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

</LinearLayout>
