<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_notification_box"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 1. बायाँ भाग: लोगो + छोटा मोड टैग -->
    <LinearLayout
        android:id="@+id/notif_logo_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/notif_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="fitCenter"
            android:contentDescription="Amon Logo" />

        <TextView
            android:id="@+id/notif_mode_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOCUS"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:textColor="#8B5CF6"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 2. बीच का भाग: बड़ा गोल्डन टाइमर -->
    <Chronometer
        android:id="@+id/notif_timer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#F59E0B"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:singleLine="true" />

    <!-- 3. दायाँ भाग: शुद्ध iOS-स्टाइल आइकॉन बटन्स (बॉर्डरलेस) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Pause बटन (सफ़ेद आइकॉन, कोई घेरा नहीं) -->
        <ImageView
            android:id="@+id/btn_notif_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notif_pause"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Pause" />

        <!-- Stop / Give Up बटन (लाल क्रॉस आइकॉन, कोई घेरा नहीं) -->
        <ImageView
            android:id="@+id/btn_notif_stop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notif_stop"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:contentDescription="Stop" />
    </LinearLayout>

</LinearLayout>
